{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/main.tsx",
    "src/weather/**/*.ts",
    "src/hooks/useWeather.ts",
    "src/map/weatherMarker.ts",
    "src/components/WeatherStatus.tsx",
    "src/components/WeatherDemoControls.tsx",
    "src/standalone/**/*.test.ts",
    "src/standalone/**/*.test.tsx",
    "src/components/MapBottomSheet.test.tsx",
    "src/pages/mapRegistration.test.ts"
  ]
}
